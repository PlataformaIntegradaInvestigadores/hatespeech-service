# Copiar este archivo como ".env" y ajustar los valores según el entorno.

DEBUG=True
# En producción no dejes "*". social-service (noviembre 2026) no arranca con
# DEBUG apagado si ALLOWED_HOSTS está vacío. Este servicio lee una lista JSON,
# por ejemplo ["hatespeech-service","localhost"].
ALLOWED_HOSTS=["*"]
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["https://centinela.epn.edu.ec"]

# Puerto 8008 dentro y fuera del contenedor (127.0.0.1:8008 en el host,
# http://hatespeech-service:8008 en centinela-net).

# Modelo real en GPU: descomentar para sumar docker-compose.gpu.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# --- Modelo -----------------------------------------------------------------
# qwen = QLoRA Qwen2.5-3B + adapter ES+ECU en GPU; mock = clasificador léxico para dev/CI.
MODEL_BACKEND=mock
# Ruta DENTRO del contenedor a la carpeta del modelo base (montada desde BASE_MODEL_HOST_DIR).
# Con HF_HUB_OFFLINE=1 no se descarga nada; también acepta un repo id si está en la caché HF.
BASE_MODEL=/base-model/Qwen2.5-3B-Instruct
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Ruta DENTRO del contenedor donde se monta el adapter (ver docker-compose.yml).
ADAPTER_PATH=/models/qlora_qwen25_3b_es_ecu
# Carpetas del host: adapters (montada en /models), modelo base (en /base-model) y caché HF.
MODELS_HOST_DIR=./models
BASE_MODEL_HOST_DIR=./models/base
HF_CACHE_HOST_DIR=./hf-cache
MODEL_VERSION=qlora-qwen25-3b-es-ecu-config3
MAX_LENGTH=128
EXPLANATION_ENABLED=True
EXPLANATION_TOP_K=8

# --- Umbrales congelados en validación (TIC, Fase 7d / 9c) -------------------
CLASS_THRESHOLD=0.50
HIDE_THRESHOLD=0.80
# 0.65 = tau ECU (EcuHate-es). Alternativa ES general: 0.80.
HITL_TAU=0.65
# Franja de revisión: REVIEW_BAND_MIN <= p_odio < HIDE_THRESHOLD -> visible, pero a la cola
# con el motivo review_band. false la desactiva.
REVIEW_BAND_ENABLED=true
REVIEW_BAND_MIN=0.65
REPORT_THRESHOLD=5

# --- Persistencia -------------------------------------------------------------
DB_NAME=hatespeech
DB_USER=hatespeech
DB_PASSWORD=replace-me
# Alias de Compose en la red default del proyecto (no uses localhost).
DATABASE_URL=postgresql+psycopg2://hatespeech:replace-me@hatespeech-db:5432/hatespeech

# --- Seguridad ----------------------------------------------------------------
# Misma llave con la que identity-service firma los JWT (SIMPLE_JWT SIGNING_KEY).
JWT_SIGNING_KEY=replace-with-monolith-jwt-signing-key
JWT_ALGORITHM=HS256
# Llave compartida SOLO con social-service (header X-Internal-Api-Key).
INTERNAL_API_KEY=replace-with-long-random-secret
