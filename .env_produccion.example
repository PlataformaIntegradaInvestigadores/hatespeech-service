# Plantilla de producción. Copiar a .env en el servidor y completar los
# secretos ahí: no van en git. Los pesos del modelo se montan por volumen.

DEBUG=False
ALLOWED_HOSTS=["hatespeech-service"]
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["https://centinela.epn.edu.ec"]

# Host 8008 (analytics-service ocupa 8006). El contenedor escucha en 8006.
HATESPEECH_PUBLISH_PORT=8008

MODEL_BACKEND=qwen
BASE_MODEL=/base-model/Qwen2.5-3B-Instruct
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ADAPTER_PATH=/models/qlora_qwen25_3b_es_ecu
MODELS_HOST_DIR=/opt/centinela/models
BASE_MODEL_HOST_DIR=/opt/centinela/models/base
HF_CACHE_HOST_DIR=/opt/centinela/hf-cache
MODEL_VERSION=qlora-qwen25-3b-es-ecu-config3
MAX_LENGTH=128
EXPLANATION_ENABLED=True
EXPLANATION_TOP_K=8

CLASS_THRESHOLD=0.50
HIDE_THRESHOLD=0.80
HITL_TAU=0.65
REVIEW_BAND_ENABLED=true
REVIEW_BAND_MIN=0.65
REPORT_THRESHOLD=5

DB_NAME=hatespeech
DB_USER=hatespeech
DB_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg2://hatespeech:replace-me@hatespeech-db:5432/hatespeech

JWT_SIGNING_KEY=replace-with-monolith-jwt-signing-key
JWT_ALGORITHM=HS256
INTERNAL_API_KEY=replace-with-long-random-secret
